FROM registry.redhat.io/rhel9/rhel-bootc:9.4 

# Install mandatory client packages for Satellite management & pull-mode REX 
RUN dnf -y install \
    subscription-manager \ 
    insights-client \
    foreman_ygg_worker \ 
    chrony \ 
    openssh-server \
    && dnf clean all 

# Configure SSH daemon for hardened access 
RUN sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config 

# Set default container entry point / init 
CMD ["/sbin/init"]
