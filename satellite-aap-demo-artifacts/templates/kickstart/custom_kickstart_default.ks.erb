<%#
kind: provision
name: Custom Kickstart Default SysAdmin
oses:
- RedHat 8
- RedHat 9
- RedHat 10
%>
<%
  os_major = @host.operatingsystem.major.to_i
  use_rhsm = os_major >= 9
-%>
lang en_US.UTF-8
keyboard us
timezone UTC --isUtc

%pre
<%= snippet 'dynamic_lvm_partitioning' %>
%end

# Partition table generated by the %pre script above.
%include /tmp/diskpart.cfg

rootpw --iscrypted <%= root_pass %>
authselect select minimal

<%# RHEL9+ registers via subscription-manager inline, before %packages, using
    the stock kickstart_rhsm snippet — NOT a "subscription_manager_registration"
    snippet, which does not exist in this Satellite instance. RHEL8 registers
    later, in %post, via the stock redhat_register snippet. -%>
<%= snippet('kickstart_rhsm') if use_rhsm -%>

reboot

%packages
@core
chrony
tar
curl
%end

%post --log=/root/ks-post.log
<% unless use_rhsm -%>
<%= snippet('redhat_register') %>
<% end -%>

# Deploy SSH Keys for Remote Execution (stock Satellite snippet)
<%= snippet 'remote_execution_ssh_keys' %>

# Trigger AAP First-Boot Provisioning Callback (stock Satellite snippet;
# only fires if the host/hostgroup parameter ansible_tower_provisioning=true)
<%= snippet 'ansible_provisioning_callback' %>
%end
